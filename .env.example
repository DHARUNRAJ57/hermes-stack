# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values marked YOUR_ or CHANGE_ME.
#   Copy-Item .env.example .env
# Never share .env. It holds your keys.
# ---------------------------------------------------------------------------

# Hermes API key (port 8642). Generate a random one with the command in README.md.
HERMES_API_KEY=CHANGE_ME_GENERATE_A_RANDOM_KEY

# NVIDIA NIM key. Used by Hindsight (its LLM) and by Hermes (its nvidia provider).
NVIDIA_API_KEY=nvapi-YOUR_NVIDIA_API_KEY

# Web dashboard login (http://127.0.0.1:9119).
HERMES_DASHBOARD_USERNAME=hermes-admin
HERMES_DASHBOARD_PASSWORD=CHANGE_ME_DASHBOARD_PASSWORD
HERMES_DASHBOARD_SECRET=CHANGE_ME_DASHBOARD_SECRET

# Optional: Hermes model name (the default works).
HERMES_MODEL=hermes-agent

# Hindsight UI login (shared access key). Generate a random one, letters and digits only.
HINDSIGHT_CP_ACCESS_KEY=CHANGE_ME_HINDSIGHT_UI_KEY
