# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values marked YOUR_ or CHANGE_ME.
#   Copy-Item .env.example .env
# Never share .env. It holds your keys.
# ---------------------------------------------------------------------------

# Key for the Hermes API (port 8642). Generate a random one with the command in
# README.md. At least 8 characters.
HERMES_API_KEY=CHANGE_ME_GENERATE_A_RANDOM_KEY

# LLM - NVIDIA NIM. Cognee uses it to extract facts and to answer recall.
LLM_PROVIDER=custom
LLM_MODEL=nvidia_nim/nvidia/nemotron-3-ultra-550b-a55b
LLM_ENDPOINT=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-YOUR_NVIDIA_API_KEY

# The same NVIDIA key for Hermes. Its "nvidia" provider reads NVIDIA_API_KEY.
NVIDIA_API_KEY=nvapi-YOUR_NVIDIA_API_KEY

# Embeddings - NVIDIA NIM, nemotron-3-embed-1b (2048 dimensions).
# EMBEDDING_DIMENSIONS must match the model. Changing it on a memory that already
# has data needs a reset of that memory first (see README.md).
EMBEDDING_PROVIDER=nvidia_nim
EMBEDDING_MODEL=nvidia_nim/nvidia/nemotron-3.5-embed-1b
EMBEDDING_INPUT_TYPE=passage
EMBEDDING_ENDPOINT=https://integrate.api.nvidia.com/v1
EMBEDDING_DIMENSIONS=2048
EMBEDDING_API_KEY=nvapi-YOUR_NVIDIA_API_KEY

# Optional: pin image versions instead of "latest".
# COGNEE_MCP_IMAGE=cognee/cognee-mcp:latest
# HERMES_IMAGE=nousresearch/hermes-agent:latest

# Web dashboard login (http://127.0.0.1:9119). Generate the password and secret the same way as HERMES_API_KEY.
HERMES_DASHBOARD_USERNAME=hermes-admin
HERMES_DASHBOARD_PASSWORD=CHANGE_ME_DASHBOARD_PASSWORD
HERMES_DASHBOARD_SECRET=CHANGE_ME_DASHBOARD_SECRET
